<Window x:Class="VelvetVault.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VelvetVault" Title="Vault" Width="1060" Height="660" MinWidth="920" MinHeight="580" Background="{DynamicResource Paper}" Foreground="{DynamicResource Ink}" FontFamily="Bahnschrift" WindowStartupLocation="CenterScreen">
<Window.Resources>
<SolidColorBrush x:Key="Paper" Color="#171815"/><SolidColorBrush x:Key="Ink" Color="#E1E1D7"/><SolidColorBrush x:Key="Muted" Color="#9B9D91"/><SolidColorBrush x:Key="Faint" Color="#41443B"/>
<Style TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Ink}"/><Setter Property="BorderThickness" Value="1.6"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="FontFamily" Value="Bahnschrift"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Face" Opacity="0.72" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(local:ButtonShape.CornerRadius)}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Face" Storyboard.TargetProperty="Opacity" From="0.6" To="1" Duration="0:0:0.65" AutoReverse="True" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></EventTrigger><EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Face" Storyboard.TargetProperty="Opacity" To="0.72" Duration="0:0:0.22"/></Storyboard></BeginStoryboard></EventTrigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.55"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderThickness" Value="2.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource Paper}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="CaretBrush" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Ink}"/><Setter Property="Padding" Value="10"/><Setter Property="FontSize" Value="14"/></Style>
<Style TargetType="PasswordBox"><Setter Property="Background" Value="{DynamicResource Paper}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="CaretBrush" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Ink}"/><Setter Property="Padding" Value="10"/><Setter Property="FontSize" Value="14"/></Style>
<Style TargetType="ComboBox"><Setter Property="Padding" Value="9"/></Style>
</Window.Resources>
<Grid Margin="22,0,22,0"><Grid.RowDefinitions><RowDefinition Height="19"/><RowDefinition/><RowDefinition Height="52"/></Grid.RowDefinitions><local:MotionRail x:Name="LiveRail" Height="10" VerticalAlignment="Top"/>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
<local:RetroFrame><Grid Margin="18,19,18,15"><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="27"/><RowDefinition/><RowDefinition Height="24"/><RowDefinition Height="42"/><RowDefinition Height="77"/></Grid.RowDefinitions><Border BorderBrush="{DynamicResource Ink}" BorderThickness="0,0,0,1" Padding="0,0,0,9"><Grid><TextBlock Text="■ ■ □" FontSize="15"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" MouseLeftButtonDown="LocalTapped"><TextBlock Text="LOCAL" FontSize="10" VerticalAlignment="Center"/><Ellipse x:Name="SoundLight" Width="5" Height="5" Fill="#FF3434" Opacity="0" Margin="5,0,0,0"><Ellipse.Effect><DropShadowEffect Color="#FF2020" BlurRadius="9" ShadowDepth="0" Opacity="1"/></Ellipse.Effect></Ellipse></StackPanel></Grid></Border><local:VaultAccessPanel x:Name="Authenticator" Grid.Row="1" Grid.RowSpan="2"/><Grid Grid.Row="3"><TextBlock Text="ORBIT 01&#10;ORBIT 02 …" FontFamily="Consolas" FontSize="8"/><TextBlock Text="ALT&#10;LOCAL CORE" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Right" TextAlignment="Right"/></Grid><StackPanel Grid.Row="4" Margin="0,5,0,0"><local:Barcode Data="VAULT-001" Height="24"/><TextBlock Text="4 002184 089424  UNIT: 6-B" FontSize="7" FontFamily="Consolas" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Row="5" Margin="0,9,0,0"><TextBlock Text="&gt; ARCHIVE / LOCAL    ON&#10;&gt; SIGNAL / OFFLINE" FontFamily="Consolas" FontSize="9" LineHeight="14"/><Border BorderBrush="{DynamicResource Ink}" BorderThickness="0,1,0,0" Margin="0,7,0,0" Padding="0,7,0,0"><Grid><TextBlock Text="VAULT—001" FontSize="16"/><TextBlock Text="»»»" HorizontalAlignment="Right" FontSize="15"/></Grid></Border><TextBlock Text="PERSONAL PASSWORD ARCHIVE" FontSize="7" Margin="0,5,0,0"/></StackPanel></Grid></local:RetroFrame>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition/></Grid.RowDefinitions>
<Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="218"/></Grid.ColumnDefinitions><Border BorderBrush="{DynamicResource Ink}" BorderThickness="1.6" CornerRadius="12" Margin="0,0,11,0"><Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><TextBox x:Name="Search" TextChanged="SearchChanged" AutomationProperties.Name="Search passwords" CaretBrush="Transparent" FontSize="18" Padding="7" BorderThickness="0" VerticalContentAlignment="Center"/><TextBlock x:Name="SearchPlaceholder" Text="SEARCH" Foreground="{DynamicResource Muted}" FontSize="17" IsHitTestVisible="False" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Text, ElementName=Search}" Value=""/><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=Search}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><local:BlinkCaret x:Name="SearchBlink" Target="{Binding ElementName=Search}" IsHitTestVisible="False" ClipToBounds="True"><local:BlinkCaret.Style><Style TargetType="local:BlinkCaret"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=Search}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:BlinkCaret.Style></local:BlinkCaret><TextBlock Grid.Column="1" Text="QUERY / RECORDS&#10;PRESS F3" FontSize="7" TextAlignment="Right" VerticalAlignment="Center"/></Grid></Border><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="+EXP" Click="ExportClick" FontSize="20" FontWeight="Bold" Margin="0"/><Button Grid.Column="2" Content="+ ADD" Click="AddClick" FontSize="20" FontWeight="Bold" Margin="0"/></Grid></Grid>
<Grid Grid.Row="1"><ScrollViewer x:Name="RecordsViewport" VerticalScrollBarVisibility="Hidden" Padding="0,0,3,0"><StackPanel x:Name="Cards"/></ScrollViewer><local:RetroFrame x:Name="EmptyState"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><local:VaultSeal x:Name="MainSeal" Width="105" Height="105"/><TextBlock x:Name="EmptyLabel" Text="VAULT / EMPTY" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,10"/><Button Content="+ ADD YOUR FIRST PASSWORD" Click="AddClick" FontSize="11"/></StackPanel></local:RetroFrame></Grid>
</Grid>
</Grid><Grid Grid.Row="2" Margin="0,9,0,0"><Border BorderBrush="{DynamicResource Ink}" BorderThickness="0,1.5,0,0" Margin="-22,0,-22,0"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="Status" Text="SAVED IN THIS .EXE" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock x:Name="StorageUsage" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center"/></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="MASTER" local:ButtonShape.CornerRadius="4" Click="MasterClick" FontSize="12" FontWeight="Bold" Padding="5,0" MinHeight="0" Height="20" Margin="0,0,7,0"/><Button Content="BACKUP" local:ButtonShape.CornerRadius="4" Click="BackupClick" FontSize="12" FontWeight="Bold" Padding="5,0" MinHeight="0" Height="20" Margin="0,0,7,0"/><Button Content="RESTORE" local:ButtonShape.CornerRadius="4" Click="RestoreClick" FontSize="12" FontWeight="Bold" Padding="5,0" MinHeight="0" Height="20" Margin="0,0,16,0"/><TextBlock x:Name="CountLabel" Text="RECORDS / 000" FontSize="20" FontWeight="Bold" Margin="0,3,0,3" VerticalAlignment="Center"/></StackPanel></Grid>
</Grid></Window>








