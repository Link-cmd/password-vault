<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF><ApplicationIcon>Vault.ico</ApplicationIcon><Product>Vault</Product><Description>Portable personal password vault</Description>
  </PropertyGroup>

<ItemGroup><Resource Include="Vault.ico" /><Resource Include="Sounds/open.mp3" Condition="Exists('Sounds/open.mp3')" /><Resource Include="Sounds/close.mp3" Condition="Exists('Sounds/close.mp3')" /><Resource Include="Fonts/SairaStencil-ExtraBold.ttf" /><Resource Include="Fonts/OFL.txt" /></ItemGroup>

<ItemGroup>
  <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  <PackageReference Include="QRCoder" Version="1.6.0" />
  <PackageReference Include="ZXing.Net" Version="0.16.11" />
</ItemGroup></Project>





